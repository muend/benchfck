{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchfck.local/schemas/public-item.schema.json",
  "title": "benchfck public item metadata v1",
  "type": "object",
  "required": [
    "schema_version", "program_id", "item_id", "arity", "output_arity",
    "grammar_shape", "program_size_tier", "e0_program_bpe_tokens",
    "e2_program_bpe_tokens", "e3_program_bpe_tokens",
    "difficulty_band", "nesting_depth", "working_set",
    "n_steps", "semantic_steps", "trace_semantic_density",
    "text_semantic_density", "prompt_tokenizer", "e2_e0_prompt_bpe_ratio",
    "e3_e0_prompt_bpe_ratio", "e2_e0_program_bpe_ratio",
    "e3_e0_program_bpe_ratio", "move_carrier", "minimum_loop_iterations",
    "s0_loops", "s1_loops", "s2_loops", "pointer_volatility",
    "t2_response_token_cap", "t3_response_token_cap",
    "available_families", "available_encodings"
  ],
  "properties": {
    "schema_version": {"const": "benchfck.public-item.v1"},
    "program_id": {"type": "string"},
    "item_id": {"type": "string"},
    "arity": {"type": "integer", "minimum": 1, "maximum": 2},
    "output_arity": {"type": "integer", "minimum": 1},
    "grammar_shape": {"type": "string"},
    "program_size_tier": {"type": "integer", "minimum": 0, "maximum": 9},
    "e0_program_bpe_tokens": {"type": "integer", "minimum": 1},
    "e2_program_bpe_tokens": {"type": "integer", "minimum": 1},
    "e3_program_bpe_tokens": {"type": "integer", "minimum": 1},
    "difficulty_band": {"enum": ["easy", "medium", "hard"]},
    "nesting_depth": {"type": "integer", "minimum": 0},
    "working_set": {"type": "integer", "minimum": 0},
    "n_steps": {"type": "integer", "minimum": 0},
    "semantic_steps": {"type": "integer", "minimum": 0},
    "trace_semantic_density": {"type": "number", "minimum": 0, "maximum": 1},
    "text_semantic_density": {"type": "number", "minimum": 0, "maximum": 1},
    "prompt_tokenizer": {"type": "string"},
    "e2_e0_prompt_bpe_ratio": {"type": "number", "minimum": 0},
    "e3_e0_prompt_bpe_ratio": {"type": "number", "minimum": 0},
    "e2_e0_program_bpe_ratio": {"type": "number", "minimum": 0},
    "e3_e0_program_bpe_ratio": {"type": "number", "minimum": 0},
    "move_carrier": {"enum": ["rle", "expanded", "omitted"]},
    "minimum_loop_iterations": {"type": "integer", "minimum": 0},
    "s0_loops": {"type": "integer", "minimum": 0},
    "s1_loops": {"type": "integer", "minimum": 0},
    "s2_loops": {"type": "integer", "minimum": 0},
    "s1_s2_ratio": {"type": ["number", "null"], "minimum": 0},
    "pointer_volatility": {"type": "number", "minimum": 0, "maximum": 1},
    "t2_response_token_cap": {"type": "integer", "minimum": 1},
    "t3_response_token_cap": {"type": "integer", "minimum": 1},
    "available_families": {"type": "array", "items": {"enum": ["T1", "T2", "T3"]}},
    "available_encodings": {"type": "array", "items": {"enum": ["E0", "E1", "E2", "E3"]}}
  },
  "additionalProperties": false
}
