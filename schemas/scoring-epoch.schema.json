{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchfck.local/schemas/scoring-epoch.schema.json",
  "title": "benchfck public scoring epoch record v1",
  "type": "object",
  "required": [
    "schema_version",
    "epoch_id",
    "status",
    "arity",
    "mechanism_commit",
    "public_config_sha256",
    "private_constructor_count",
    "private_constructor_commitment_sha256",
    "private_item_batch_commitment_sha256",
    "private_validation_report_sha256",
    "opened_at_utc",
    "activated_at_utc",
    "closed_at_utc",
    "previous_epoch_id",
    "closure_reason",
    "disclosure_commit",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "benchfck.scoring-epoch.v1"},
    "epoch_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "status": {"enum": ["planned", "active", "closed", "retired"]},
    "arity": {"type": "integer", "minimum": 1},
    "mechanism_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "public_config_sha256": {"$ref": "#/$defs/sha256"},
    "private_constructor_count": {"type": "integer", "minimum": 1},
    "private_constructor_commitment_sha256": {"$ref": "#/$defs/sha256"},
    "private_item_batch_commitment_sha256": {"$ref": "#/$defs/sha256"},
    "private_validation_report_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "opened_at_utc": {"$ref": "#/$defs/utc"},
    "activated_at_utc": {"anyOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]},
    "closed_at_utc": {"anyOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]},
    "previous_epoch_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"
    },
    "closure_reason": {"type": ["string", "null"]},
    "disclosure_commit": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{40}$"
    },
    "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "planned"}}},
      "then": {
        "properties": {
          "private_validation_report_sha256": {"type": "null"},
          "activated_at_utc": {"type": "null"},
          "closed_at_utc": {"type": "null"},
          "closure_reason": {"type": "null"},
          "disclosure_commit": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["active", "closed", "retired"]}}},
      "then": {
        "properties": {
          "activated_at_utc": {"$ref": "#/$defs/utc"},
          "private_validation_report_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "active"}}},
      "then": {
        "properties": {
          "closed_at_utc": {"type": "null"},
          "closure_reason": {"type": "null"},
          "disclosure_commit": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["closed", "retired"]}}},
      "then": {
        "properties": {
          "closed_at_utc": {"$ref": "#/$defs/utc"},
          "closure_reason": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "closed"}}},
      "then": {"properties": {"disclosure_commit": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"const": "retired"}}},
      "then": {"properties": {"disclosure_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "additionalProperties": false
}
